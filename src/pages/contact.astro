---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings, generateBreadcrumbs } from "../lib/site";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);

const settings = await getSiteSettings();
const phoneClean = (p: string) => p.replace(/[^0-9]/g, "");
const phoneDisplay = (p: string) => {
  const clean = phoneClean(p);
  if (clean.startsWith("91") && clean.length === 12) {
    return `+91 ${clean.slice(2, 7)} ${clean.slice(7)}`;
  }
  return clean.replace(/(\d{5})(\d{5})/, "$1 $2");
};
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with ZN Enterprises for corporate signage solutions across India. Call, email, or visit our Bengaluru office."
  seo={{ breadcrumbs, pageType: "ContactPage" }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
          <div>
            <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Contact</span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
              Get in <span class="gradient-text">Touch</span>
            </h1>
            <p class="text-muted text-lg leading-relaxed mb-10">
              Ready to start your signage project? Our team is available to discuss your requirements, provide a quote, or schedule a site survey.
            </p>

            <div class="space-y-6">
              <div class="flex items-start gap-5">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">Office Address</h3>
                  <p class="text-muted mt-1 leading-relaxed">
                    No. 15, ST Mary's Layout,<br />
                    1st Floor, SM &amp; Sons,<br />
                    K.G Halli,<br />
                    Bengaluru - 560045
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-5">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">Phone</h3>
                  <div class="text-muted mt-1 space-y-1">
                    {settings.phone.map((p) => (
                      <a href={`tel:${phoneClean(p)}`} class="block hover:text-accent transition-colors">{phoneDisplay(p)}</a>
                    ))}
                  </div>
                </div>
              </div>

              <div class="flex items-start gap-5">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                </div>
                <div>
                  <h3 class="font-semibold">Email</h3>
                  <p class="text-muted mt-1">
                    <a href={`mailto:${settings.email}`} class="hover:text-accent transition-colors">{settings.email}</a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-5">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">Working Hours</h3>
                  <p class="text-muted mt-1">{settings.workingHours}</p>
                </div>
              </div>

              <div class="flex items-start gap-5">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">Factory Address</h3>
                  <p class="text-muted mt-1 leading-relaxed">
                    No. 85/2, Site No. 9, Sulikere Road,<br />
                    Ramasandra Village, Sulikere Post,<br />
                    Hobli Kengeri,<br />
                    Bengaluru - 560060
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-2xl font-bold mb-2">Send Us a Message</h2>
            <p class="text-muted text-sm mb-6">Fill out the form and we'll get back to you within 24 hours.</p>
            <form id="contact-form" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium mb-2">Full Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full rounded-xl border border-border bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium mb-2">Email *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full rounded-xl border border-border bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
                    placeholder="your@email.com"
                  />
                </div>
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium mb-2">Phone</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full rounded-xl border border-border bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
                  placeholder="+91 ..."
                />
              </div>
              <div>
                <label for="subject" class="block text-sm font-medium mb-2">Subject</label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full rounded-xl border border-border bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
                >
                  <option value="">Select a subject</option>
                  <option value="corporate-signage">Corporate Signage</option>
                  <option value="petroleum-rvi">Petroleum RVI</option>
                  <option value="led-signage">LED Signage</option>
                  <option value="installation">Installation Services</option>
                  <option value="maintenance">Maintenance / AMC</option>
                  <option value="general">General Enquiry</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium mb-2">Message *</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full rounded-xl border border-border bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors resize-none"
                  placeholder="Tell us about your project requirements..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 w-full py-4 shadow-sm hover:shadow-md active:scale-[0.98]"
              >
                Send Message
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="h-[400px] w-full bg-muted/10">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7777.345!2d77.3885536!3d12.9437518!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae39de1f66012d%3A0xcf18c808b3ae7984!2sZN%20ENTERPRISES!5e0!3m2!1sen!2sin"
          width="100%"
          height="100%"
          style="border: 0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="ZN Enterprises Location"
        ></iframe>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ whatsappNumber: phoneClean(settings.social?.whatsapp ?? settings.phone[0]) }}>
  const form = document.getElementById("contact-form");
  const submitBtn = form?.querySelector("button[type='submit']");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const name = document.getElementById("name").value.trim();
    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const subject = document.getElementById("subject").value;
    const message = document.getElementById("message").value.trim();

    const now = new Date();
    const dateStr = now.toLocaleDateString("en-IN", {
      day: "numeric", month: "short", year: "numeric",
    });

    const subjectLabel = {
      "corporate-signage": "Corporate Signage",
      "petroleum-rvi": "Petroleum RVI",
      "led-signage": "LED Signage",
      "installation": "Installation Services",
      "maintenance": "Maintenance / AMC",
      "general": "General Enquiry",
    }[subject] || "General Enquiry";

    const text = [
      `🏢 *New Website Enquiry*`,
      `📅 ${dateStr}`,
      ``,
      `*Contact Details*`,
      `├ 👤 Name: ${name}`,
      `├ 📧 Email: ${email}`,
      `├ 📞 Phone: ${phone || "—"}`,
      `└ 📋 Subject: ${subjectLabel}`,
      ``,
      `*Message*`,
      `${message}`,
      ``,
      `_Sent via ZN Enterprises contact form_`,
    ].join("\n");

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
    window.open(url, "_blank", "noopener,noreferrer");

    submitBtn && (submitBtn.textContent = "Message Sent ✓");
    setTimeout(() => {
      submitBtn && (submitBtn.innerHTML = `Send Message <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>`);
    }, 3000);
  });
</script>
