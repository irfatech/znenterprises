---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { getCollection } from "astro:content";
import { p, generateBreadcrumbs } from "../lib/site";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);


const projects = (await getCollection("projects"))
  .filter((project) => project.data.images.length > 0)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const categories = ["All", ...new Set(projects.map((project) => project.data.category).filter(Boolean))];
---

<BaseLayout
  title="Our Projects"
  description="Browse ZN Enterprises' portfolio of corporate signage projects across India — petroleum stations, corporate branding, retail signage, and more."
  seo={{ breadcrumbs }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Projects</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Our <span class="gradient-text">Projects</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            A showcase of our corporate signage projects across India — demonstrating our expertise in design, precision manufacturing, and professional installation for leading brands.
          </p>
        </div>

        {projects.length > 0 ? (
          <>
            <div class="flex flex-wrap gap-2 mt-10 mb-10" id="gallery-filters">
              {categories.map((cat) => (
                <button
                  class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 data-[active=true]:bg-accent data-[active=true]:text-accent-text bg-muted/10 text-muted hover:bg-muted/20"
                  data-active={cat === "All" ? "true" : "false"}
                  data-filter={cat.toLowerCase()}
                >
                  {cat}
                </button>
              ))}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="project-grid">
              {projects.map((project) => (
                <a
                  href={p(`/projects/${project.id}/`)}
                  class="group relative aspect-[4/3] rounded-2xl overflow-hidden bg-muted/10 ring-1 ring-border hover:ring-accent-border hover:shadow-lg transition-all duration-300"
                  data-category={project.data.category?.toLowerCase() || "general"}
                >
                  <img
                    src={p(project.data.images[0])}
                    alt={project.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent" />
                  {project.data.images.length > 1 && (
                    <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur text-white text-xs font-medium">
                      {project.data.images.length} photos
                    </span>
                  )}
                  <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/10 transition-colors duration-300">
                    <span class="opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-300 inline-flex items-center gap-2 rounded-full bg-white/95 text-body px-4 py-2 text-sm font-medium shadow-lg">
                      View Case Study
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </span>
                  </div>
                  <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
                    {project.data.category && (
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wide bg-accent text-accent-text mb-2">
                        {project.data.category}
                      </span>
                    )}
                    <h3 class="text-white font-semibold leading-snug">{project.data.title}</h3>
                    {(project.data.client || project.data.location) && (
                      <p class="text-white/70 text-sm mt-1">
                        {[project.data.client, project.data.location].filter(Boolean).join(" · ")}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-20 bg-card border border-border rounded-2xl mt-12">
            <svg class="h-16 w-16 mx-auto text-muted/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
            </svg>
            <h3 class="text-xl font-semibold mb-2">Project Gallery Coming Soon</h3>
            <p class="text-muted mb-6">We are compiling our project portfolio. Contact us to see examples of our work.</p>
            <a
              href={p("/contact/")}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200"
            >
              Request Portfolio
            </a>
          </div>
        )}
      </div>
    </section>

    <CTA
      title="Start Your Project"
      description="Ready to bring your brand to life? Contact us to discuss your signage requirements."
      primaryLabel="Get in Touch"
      primaryHref={p("/contact/")}
    />
  </div>
</BaseLayout>

<script>
  const filters = document.querySelectorAll("[data-filter]");
  const cards = document.querySelectorAll("[data-category]");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      filters.forEach((b) => (b.dataset.active = "false"));
      btn.dataset.active = "true";
      cards.forEach((card) => {
        card.style.display = filter === "all" || card.dataset.category === filter ? "" : "none";
      });
    });
  });
</script>
