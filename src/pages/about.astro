---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const team = (await getCollection("team")).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const values = [
  { title: "Engineering Quality", description: "Every signage solution is manufactured to the highest engineering standards with precision and durability." },
  { title: "Corporate Standards", description: "We maintain strict adherence to corporate branding guidelines and quality protocols." },
  { title: "Reliability", description: "We deliver on our promises with consistent quality and timely project completion." },
  { title: "Long-Term Partnerships", description: "Building lasting relationships with clients through exceptional service and support." },
];
---

<BaseLayout
  title="About Us"
  description="Learn about Z N ENTERPRISES — India's trusted corporate signage partner since 2017."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/about/" class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">About Us</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            India's Trusted<br />
            <span class="gradient-text">Corporate Signage Partner</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Z N ENTERPRISES specializes in designing, manufacturing, installing, repairing, and maintaining premium corporate signage across India. With a deep understanding of corporate branding requirements and strong manufacturing capabilities, we deliver signage solutions that meet the highest standards of quality and precision.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-section flex items-center justify-center">
            <div class="text-center p-12">
              <svg class="h-24 w-24 mx-auto text-accent/20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" /></svg>
              <p class="text-muted">Corporate Signage Manufacturing</p>
            </div>
          </div>
          <div>
            <h2 class="text-2xl sm:text-3xl font-semibold mb-6">Our <span class="gradient-text">Story</span></h2>
            <div class="space-y-4 text-muted leading-relaxed">
              <p>Founded with a vision to deliver premium corporate signage solutions in India, Z N ENTERPRISES has grown into a comprehensive signage partner serving major corporations across multiple sectors.</p>
              <p>Over the years, we have built a state-of-the-art manufacturing facility and assembled a team of skilled professionals dedicated to precision manufacturing and quality execution. Our expertise spans across petroleum, automotive, banking, telecom, and retail sectors.</p>
              <p>Today, we are proud to serve leading corporations including HPCL, BPCL, IOCL, and major brands across India, providing end-to-end signage solutions from design conception to installation and ongoing maintenance.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title">
          <h2>Our <span class="gradient-text">Values</span></h2>
          <p>The principles that guide everything we do.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map((v) => (
            <div class="card p-6 text-center">
              <h3 class="font-semibold text-lg mb-3">{v.title}</h3>
              <p class="text-muted text-sm">{v.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {team.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title">
          <h2>Meet Our <span class="gradient-text">Team</span></h2>
          <p>Dedicated professionals committed to your satisfaction.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {team.map((member) => (
            <div class="card p-6 text-center group">
              <div class="mx-auto mb-4 h-24 w-24 rounded-full bg-accent-soft flex items-center justify-center text-accent text-3xl font-bold group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                {member.data.name.split(" ").map((n: string) => n[0]).join("").slice(0, 2)}
              </div>
              <h3 class="font-semibold text-lg">{member.data.name}</h3>
              <p class="text-accent text-sm font-medium mb-2">{member.data.role}</p>
              <p class="text-muted text-sm">{member.data.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}
  </div>
</BaseLayout>
