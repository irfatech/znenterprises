---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatsBar from "../components/StatsBar.astro";
import CTA from "../components/CTA.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const p = (path) => path?.startsWith("/") ? base + path.replace(/^\//, "") : path;

const [aboutEntry] = await getCollection("about");
const a = aboutEntry?.data;

const team = (await getCollection("team")).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const heroLabel = a?.heroLabel ?? "/// About";
const heroHeading = a?.heroHeading ?? "India's Trusted Corporate Signage Partner";
const heroHighlight = a?.heroHighlight ?? "Corporate Signage Partner";
const heroDescription = a?.heroDescription ?? "";

const storyImage = a?.storyImage ? p(a.storyImage) : p("/images/about-1.jpg");
const storyImageAlt = a?.storyImageAlt ?? "";
const storyHeading = a?.storyHeading ?? "Our";
const storyHighlight = a?.storyHighlight ?? "Story";
const storyParagraphs = a?.storyParagraphs ?? [];
const stats = a?.stats ?? [];

const missionTitle = a?.missionTitle ?? "Our Mission";
const missionText = a?.missionText ?? "";
const visionTitle = a?.visionTitle ?? "Our Vision";
const visionText = a?.visionText ?? "";

const valuesSectionLabel = a?.valuesSectionLabel ?? "/// Values";
const valuesHeading = a?.valuesHeading ?? "Our Values";
const valuesHighlight = a?.valuesHighlight ?? "Values";
const valuesSubtitle = a?.valuesSubtitle ?? "";
const values = a?.values ?? [];

const ctaTitle = a?.ctaTitle ?? "Let's Build Your Brand Together";
const ctaDescription = a?.ctaDescription ?? "";
const ctaPrimaryLabel = a?.ctaPrimaryLabel ?? "Get in Touch";
const ctaPrimaryLink = a?.ctaPrimaryLink ? p(a.ctaPrimaryLink) : p("/contact/");
const ctaSecondaryLabel = a?.ctaSecondaryLabel ?? "View Our Services";
const ctaSecondaryLink = a?.ctaSecondaryLink ? p(a.ctaSecondaryLink) : p("/services/");

const heroHeadingParts = heroHeading.split(heroHighlight);
const showHeroHighlight = heroHeadingParts.length > 1 && heroHighlight;

const storyHeadingParts = storyHeading.split(storyHighlight);
const showStoryHighlight = storyHeadingParts.length > 1 && storyHighlight;

const valuesHeadingParts = valuesHeading.split(valuesHighlight);
const showValuesHighlight = valuesHeadingParts.length > 1 && valuesHighlight;
---

<BaseLayout
  title="About Us"
  description="Learn about ZN Enterprises — India's trusted corporate signage and Retail Visual Identity (RVI) partner since 2017."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">{heroLabel}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            {showHeroHighlight ? heroHeadingParts[0] : heroHeading}
            {showHeroHighlight && <span class="gradient-text">{heroHighlight}</span>}
            {showHeroHighlight && heroHeadingParts.slice(1).join("")}
          </h1>
          <p class="text-muted text-lg leading-relaxed">{heroDescription}</p>
        </div>
      </div>
    </section>

    <StatsBar />

    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden">
            <img src={storyImage} alt={storyImageAlt} class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold mb-6">
              {showStoryHighlight ? storyHeadingParts[0] : storyHeading}
              {showStoryHighlight && <span class="gradient-text">{storyHighlight}</span>}
              {showStoryHighlight && storyHeadingParts.slice(1).join("")}
            </h2>
            <div class="space-y-4 text-muted leading-relaxed">
              {storyParagraphs.map((p) => <p>{p}</p>)}
            </div>

            {stats.length > 0 && (
              <div class="mt-8 grid grid-cols-2 gap-4">
                {stats.map((s) => (
                  <div class="bg-card border border-border rounded-xl p-5 text-center">
                    <div class="text-3xl font-black text-accent">{s.number}</div>
                    <div class="text-sm text-muted mt-1">{s.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Mission & Vision */}
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 gap-8">
          <div class="bg-card border border-border rounded-2xl p-8 sm:p-10 hover:border-accent-border hover:shadow-lg transition-all duration-300">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-accent-soft text-accent mb-6">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
            </div>
            <h3 class="text-xl font-bold mb-4">{missionTitle}</h3>
            <p class="text-muted leading-relaxed">{missionText}</p>
          </div>
          <div class="bg-card border border-border rounded-2xl p-8 sm:p-10 hover:border-accent-border hover:shadow-lg transition-all duration-300">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-accent-soft text-accent mb-6">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-xl font-bold mb-4">{visionTitle}</h3>
            <p class="text-muted leading-relaxed">{visionText}</p>
          </div>
        </div>
      </div>
    </section>

    {/* Values */}
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">{valuesSectionLabel}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            {showValuesHighlight ? valuesHeadingParts[0] : valuesHeading}
            {showValuesHighlight && <span class="gradient-text">{valuesHighlight}</span>}
            {showValuesHighlight && valuesHeadingParts.slice(1).join("")}
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">{valuesSubtitle}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map((v) => (
            <div class="bg-card border border-border rounded-xl p-6 hover:border-accent-border hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-center">
              <h3 class="font-semibold text-lg mb-3">{v.title}</h3>
              <p class="text-muted text-sm leading-relaxed">{v.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Team */}
    {team.length > 0 && (
      <section class="py-16 sm:py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12 sm:mb-16">
            <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Team</span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
              Meet Our <span class="gradient-text">Team</span>
            </h2>
            <p class="text-muted text-lg max-w-2xl mx-auto">Experienced professionals committed to delivering engineering excellence.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {team.map((member) => (
              <div class="bg-card border border-border rounded-xl p-6 text-center hover:border-accent-border hover:shadow-lg transition-all duration-300 group">
                <div class="mx-auto mb-4 h-24 w-24 rounded-full bg-accent-soft flex items-center justify-center text-accent text-3xl font-bold group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                  {member.data.name.split(" ").map((n: string) => n[0]).join("").slice(0, 2)}
                </div>
                <h3 class="font-semibold text-lg">{member.data.name}</h3>
                <p class="text-accent text-sm font-medium mb-2">{member.data.role}</p>
                {member.data.bio && <p class="text-muted text-sm">{member.data.bio}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA
      title={ctaTitle}
      description={ctaDescription}
      primaryLabel={ctaPrimaryLabel}
      primaryHref={ctaPrimaryLink}
      secondaryLabel={ctaSecondaryLabel}
      secondaryHref={ctaSecondaryLink}
    />
  </div>
</BaseLayout>
