---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const allProducts = (await getCollection("products"))
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const categories = [...new Set(allProducts.map((p) => p.data.category))];
---

<BaseLayout
  title="Products"
  description="Explore our comprehensive range of premium corporate signage products including LED boards, illuminated signage, ACP signage, and more."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/products/" class="mb-8" />
        <div class="section-title text-left max-w-2xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Our Products</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Signage <span class="gradient-text">Products</span>
          </h1>
          <p class="text-muted text-lg">
            Premium signage solutions engineered for corporate excellence, manufactured with precision and durability.
          </p>
        </div>

        {categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            <span class="px-5 py-2 rounded-full text-sm font-medium bg-accent text-accent-text">All</span>
            {categories.map((cat) => (
              <span class="px-5 py-2 rounded-full text-sm font-medium bg-muted/10 text-muted">{cat}</span>
            ))}
          </div>
        )}

        {allProducts.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mt-12">
            {allProducts.map((product) => (
              <article class="rounded-2xl bg-card border-border shadow-sm hover:shadow-lg hover:border-accent-border hover:-translate-y-1 transition-all duration-300 overflow-hidden group">
                <div class="p-6 sm:p-8">
                  <div class="mb-4">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-accent">{product.data.category}</span>
                  </div>
                  <h3 class="text-xl font-semibold mb-3">{product.data.title}</h3>
                  <p class="text-muted text-sm leading-relaxed mb-4">{product.data.excerpt || product.data.description}</p>
                  {product.data.features && product.data.features.length > 0 && (
                    <ul class="space-y-2 mb-5">
                      {product.data.features.slice(0, 3).map((feature) => (
                        <li class="flex items-center gap-2 text-sm text-body/70">
                          <svg class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  )}
                  <a
                    href={`/products/${product.id}/`}
                    class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-hover transition-colors"
                  >
                    Learn More
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-20">
            <h3 class="text-xl font-semibold mb-2">Products Coming Soon</h3>
            <p class="text-muted">Check back soon for our product catalog or contact us directly.</p>
            <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 mt-6 inline-flex">Contact Us</a>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
