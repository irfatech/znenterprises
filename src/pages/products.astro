---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { getCollection } from "astro:content";
import { p, generateBreadcrumbs, absoluteUrl } from "../lib/site";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);


const allProducts = (await getCollection("products"))
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const categories = [...new Set(allProducts.map((p) => p.data.category))];

const itemListSchema = {
  "@type": "ItemList",
  "@id": absoluteUrl("/products/#itemlist"),
  name: "Signage Products",
  numberOfItems: allProducts.length,
  itemListElement: allProducts.map((product, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: product.data.title,
    url: absoluteUrl(`/products/${product.id}/`),
  })),
};
---

<BaseLayout
  title="Products"
  description="Explore premium signage products from ZN Enterprises — pump & canopy signage, LED signage, highway & urban pylon signage, and ACP cladding & facades."
  seo={{ breadcrumbs, mainEntity: itemListSchema }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Products</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Signage <span class="gradient-text">Products</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Premium signage solutions engineered for corporate excellence — manufactured with precision materials, structural-grade fabrication, and brand-compliant finishes.
          </p>
        </div>

        {allProducts.length > 0 ? (
          <>
            {categories.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-10 mb-10">
                {categories.map((cat) => (
                  <span class="px-4 py-2 rounded-full text-sm font-medium bg-accent-soft text-accent">
                    {cat}
                  </span>
                ))}
              </div>
            )}

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mt-12">
              {allProducts.map((product) => (
                <article class="rounded-2xl bg-card border border-border hover:shadow-lg hover:border-accent-border hover:-translate-y-1 transition-all duration-300 overflow-hidden group">
                  {product.data.image && (
                    <a href={p(`/products/${product.id}/`)} class="block" tabindex="-1" aria-hidden="true">
                      <div class="aspect-[16/10] overflow-hidden">
                        <img
                          src={p(product.data.image)}
                          alt={product.data.title}
                          loading="lazy"
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        />
                      </div>
                    </a>
                  )}
                  <div class="p-6 sm:p-8">
                    <div class="mb-4">
                      {product.data.category && (
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-accent">{product.data.category}</span>
                      )}
                    </div>
                    <h3 class="text-xl font-semibold mb-3">{product.data.title}</h3>
                    <p class="text-muted text-sm leading-relaxed mb-4">{product.data.excerpt || product.data.description}</p>
                    {product.data.features && product.data.features.length > 0 && (
                      <ul class="space-y-2 mb-5">
                        {product.data.features.slice(0, 4).map((feature: string) => (
                          <li class="flex items-center gap-2 text-sm text-body/70">
                            <svg class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            {feature}
                          </li>
                        ))}
                      </ul>
                    )}
                    <a
                      href={p(`/products/${product.id}/`)}
                      class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-hover transition-colors"
                    >
                      Learn More
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-20 bg-card border border-border rounded-2xl mt-12">
            <svg class="h-16 w-16 mx-auto text-muted/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
            </svg>
            <h3 class="text-xl font-semibold mb-2">Product Catalog Coming Soon</h3>
            <p class="text-muted mb-6">Contact us directly for our complete product range and specifications.</p>
            <a
              href={p("/contact/")}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200"
            >
              Contact Us
            </a>
          </div>
        )}
      </div>
    </section>

    <CTA
      title="Need a Custom Signage Solution?"
      description="We design and fabricate custom signage tailored to your brand requirements. Get in touch for a consultation."
      primaryLabel="Request a Quote"
      primaryHref={p("/contact/")}
    />
  </div>
</BaseLayout>
