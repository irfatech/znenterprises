---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const base = import.meta.env.BASE_URL;
const p = (path) => path?.startsWith("/") ? base + path.replace(/^\//, "") : path;

const industries = [
  {
    sector: "Petroleum & Fuel",
    description: "End-to-end Retail Visual Identity (RVI) solutions for fuel stations, petrol pumps, EV charging stations, QOC kiosks, and oil marketing companies. Our primary area of specialization.",
    clients: ["IOCL", "HPCL", "BPCL", "CPCL", "MRPL", "Shell", "Reliance", "Aegis"],
    icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12",
  },
  {
    sector: "Automotive",
    description: "Complete dealership branding and showroom signage solutions for automotive OEMs and dealer networks across India.",
    clients: ["Honda", "TVS", "Suzuki", "Yamaha"],
    icon: "M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776",
  },
  {
    sector: "Banking & Finance",
    description: "Corporate signage and branding solutions for banks and financial institutions, including branch identity rollouts.",
    clients: ["SBI", "Bank of India", "ICICI Bank", "HDFC Bank"],
    icon: "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    sector: "Telecommunications",
    description: "Retail identity rollout projects for telecom providers — store signage, branding, and corporate identity solutions.",
    clients: ["Airtel", "Vodafone Idea", "Reliance Jio"],
    icon: "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155",
  },
  {
    sector: "Industrial & Manufacturing",
    description: "Factory branding, corporate signage, and wayfinding systems for industrial parks, manufacturing facilities, and IT campuses.",
    clients: ["Industrial Parks", "Manufacturing Units", "IT Campuses"],
    icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z",
  },
];
---

<BaseLayout
  title="Industries We Serve"
  description="ZN Enterprises provides premium corporate signage solutions across petroleum, automotive, banking, telecom, and industrial sectors in India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Industries</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Industries <span class="gradient-text">We Serve</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            From petroleum retail outlets to automotive showrooms, bank branches to telecom stores — we deliver brand-compliant signage solutions across diverse sectors.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
          {industries.map((industry) => (
            <div class="bg-card border border-border rounded-xl p-6 sm:p-8 hover:border-accent-border hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
              <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-accent-soft text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-accent-text">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={industry.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3">{industry.sector}</h3>
              <p class="text-muted text-sm leading-relaxed mb-5">{industry.description}</p>
              <div class="flex flex-wrap gap-2">
                {industry.clients.map((client) => (
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-accent-soft text-accent">{client}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTA
      title="Ready to Work Together?"
      description="Let us be your signage partner. Contact our team to discuss your industry-specific branding requirements."
      primaryLabel="Get in Touch"
      primaryHref={p("/contact/")}
    />
  </div>
</BaseLayout>
