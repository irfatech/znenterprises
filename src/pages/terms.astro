---
import BaseLayout from "../layouts/BaseLayout.astro";
import { generateBreadcrumbs } from "../lib/site";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);
---

<BaseLayout
  title="Terms & Conditions"
  description="Terms and conditions for ZN Enterprises website."
  seo={{ breadcrumbs, hideBusinessSchema: true }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-8">
          Terms & <span class="gradient-text">Conditions</span>
        </h1>
        <div class="prose prose-lg max-w-none text-muted space-y-6">
          <p>By using this website, you agree to the following terms and conditions.</p>
          <h2 class="text-xl font-semibold text-body">Use of Website</h2>
          <p>This website is provided for informational purposes about ZN Enterprises and its services. You may use this site for lawful purposes only.</p>
          <h2 class="text-xl font-semibold text-body">Intellectual Property</h2>
          <p>All content, images, and materials on this website are the property of ZN Enterprises unless otherwise noted.</p>
          <h2 class="text-xl font-semibold text-body">Limitation of Liability</h2>
          <p>ZN Enterprises shall not be liable for any damages arising from the use or inability to use this website.</p>
          <h2 class="text-xl font-semibold text-body">Changes</h2>
          <p>We reserve the right to modify these terms at any time. Changes will be posted on this page.</p>
          <h2 class="text-xl font-semibold text-body">Contact</h2>
          <p>For questions about these terms, contact us at imran@znenterprises.in.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
