---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings, absoluteUrl, generateBreadcrumbs } from "../lib/site";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);

const settings = await getSiteSettings();
const datePosted = new Date().toISOString().split("T")[0];
const validThrough = new Date(Date.now() + 90 * 86400000).toISOString().split("T")[0];

const employmentType = (t: string) =>
  t === "Full-time" ? "FULL_TIME" : t === "Part-time" ? "PART_TIME" : t === "Contract" ? "CONTRACTOR" : "OTHER";

const positions = [
  {
    title: "Signage Fabrication Technician",
    type: "Full-time",
    location: "Bengaluru",
    description: "Experienced fabrication technician skilled in ACP, acrylic, metal, and LED signage manufacturing.",
  },
  {
    title: "Installation Supervisor",
    type: "Full-time",
    location: "Bengaluru",
    description: "Supervise signage installation projects across Karnataka and coordinate with client site teams.",
  },
  {
    title: "Graphic Designer",
    type: "Full-time",
    location: "Bengaluru",
    description: "Creative designer with experience in corporate branding, RVI design, and signage layout.",
  },
  {
    title: "Project Manager",
    type: "Full-time",
    location: "Bengaluru",
    description: "Manage end-to-end signage project execution for corporate clients across multiple sectors.",
  },
];

const jobsSchema = {
  "@type": "ItemList",
  "@id": absoluteUrl("/careers/#joblist"),
  name: "Open Positions at ZN Enterprises",
  itemListElement: positions.map((job, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "JobPosting",
      "@id": absoluteUrl(`/careers/#job-${i + 1}`),
      title: job.title,
      description: job.description,
      datePosted,
      validThrough,
      employmentType: employmentType(job.type),
      hiringOrganization: { "@id": `${settings.url}/#organization` },
      jobLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: job.location,
          addressRegion: "Karnataka",
          addressCountry: "IN",
        },
      },
      directApply: true,
      url: absoluteUrl("/careers/"),
    },
  })),
};
---

<BaseLayout
  title="Careers"
  description="Join ZN Enterprises and build a career in the corporate signage industry. We're hiring skilled professionals in Bengaluru."
  seo={{ breadcrumbs, mainEntity: jobsSchema }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Careers</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Join Our <span class="gradient-text">Team</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Build your career with India's trusted corporate signage company. We're always looking for skilled professionals who share our commitment to quality and engineering excellence.
          </p>
        </div>

        <div class="mt-12 space-y-4">
          {positions.length > 0 ? (
            positions.map((position) => (
              <div class="bg-card border border-border rounded-xl p-6 sm:p-8 hover:border-accent-border hover:shadow-lg transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-semibold mb-2">{position.title}</h3>
                    <div class="flex flex-wrap gap-3 text-sm text-muted">
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        {position.type}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                        {position.location}
                      </span>
                    </div>
                  </div>
                  <a
                    href={`mailto:imran@znenterprises.in?subject=Application for ${encodeURIComponent(position.title)}`}
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 shrink-0 active:scale-[0.98]"
                  >
                    Apply Now
                  </a>
                </div>
                <p class="mt-4 text-muted text-sm">{position.description}</p>
              </div>
            ))
          ) : (
            <div class="text-center py-20 bg-card border border-border rounded-xl">
              <h3 class="text-xl font-semibold mb-2">No Open Positions</h3>
              <p class="text-muted">We don't have any open positions right now. Send your resume to imran@znenterprises.in and we'll keep you in mind.</p>
            </div>
          )}
        </div>

        <div class="mt-12 bg-card border border-border rounded-xl p-8 text-center hover:border-accent-border transition-all duration-300">
          <h2 class="text-2xl font-bold mb-4">Don't See a Matching Role?</h2>
          <p class="text-muted mb-6">We're always interested in connecting with talented professionals. Send your resume to our hiring team.</p>
          <a
            href="mailto:imran@znenterprises.in"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 active:scale-[0.98]"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
            Send Your Resume
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
