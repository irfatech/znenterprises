---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const positions = [
  {
    title: "Signage Fabrication Technician",
    type: "Full-time",
    location: "Bangalore",
    description: "We are looking for experienced fabrication technicians skilled in ACP, acrylic, metal, and LED signage manufacturing.",
  },
  {
    title: "Installation Supervisor",
    type: "Full-time",
    location: "Bangalore",
    description: "Seeking an experienced installation supervisor to lead signage installation projects across Karnataka.",
  },
  {
    title: "Graphic Designer",
    type: "Full-time",
    location: "Bangalore",
    description: "Looking for a creative graphic designer with experience in corporate branding and signage design.",
  },
  {
    title: "Project Manager",
    type: "Full-time",
    location: "Bangalore",
    description: "Experienced project manager to oversee end-to-end signage project execution for corporate clients.",
  },
];
---

<BaseLayout
  title="Careers"
  description="Join Z N ENTERPRISES and build a career in the corporate signage industry. We're hiring skilled professionals."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/careers/" class="mb-8" />
        <div class="section-title text-left max-w-2xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Careers</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Join Our <span class="gradient-text">Team</span>
          </h1>
          <p class="text-muted text-lg">
            Build your career with India's trusted corporate signage company. We're always looking for talented individuals.
          </p>
        </div>

        <div class="mt-12 space-y-4">
          {positions.length > 0 ? (
            positions.map((position) => (
              <div class="card p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-semibold mb-2">{position.title}</h3>
                    <div class="flex flex-wrap gap-3 text-sm text-muted">
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        {position.type}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                        {position.location}
                      </span>
                    </div>
                  </div>
                  <a
                    href={`mailto:careers@znenterprises.in?subject=Application for ${encodeURIComponent(position.title)}`}
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 shrink-0"
                  >
                    Apply Now
                  </a>
                </div>
                <p class="mt-4 text-muted text-sm">{position.description}</p>
              </div>
            ))
          ) : (
            <div class="text-center py-20">
              <h3 class="text-xl font-semibold mb-2">No Open Positions</h3>
              <p class="text-muted">We don't have any open positions right now. Check back later or send your resume to careers@znenterprises.in</p>
            </div>
          )}
        </div>

        <div class="mt-12 card p-8 text-center">
          <h2 class="text-2xl font-semibold mb-4">Don't See a Matching Role?</h2>
          <p class="text-muted mb-6">We're always interested in connecting with talented professionals. Send your resume to our careers team.</p>
          <a href="mailto:careers@znenterprises.in" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200">
            Send Your Resume
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
