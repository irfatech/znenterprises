---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { p, generateBreadcrumbs, absoluteUrl } from "../lib/site";
import { authorNode } from "../lib/schema";
const breadcrumbs = generateBreadcrumbs(Astro.url.pathname);


const posts = (await getCollection("blog"))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.map((p) => p.data.category))];
const orgId = absoluteUrl("/#organization");

const blogSchema = {
  "@type": "Blog",
  "@id": absoluteUrl("/blog/#blog"),
  name: "ZN Enterprises Blog",
  url: absoluteUrl("/blog/"),
  description: "Corporate signage insights, RVI industry news, branding trends, and best practices from the ZN Enterprises team.",
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": absoluteUrl(`/blog/${post.id}/`),
    headline: post.data.title,
    description: post.data.excerpt,
    url: absoluteUrl(`/blog/${post.id}/`),
    mainEntityOfPage: absoluteUrl(`/blog/${post.id}/`),
    datePublished: post.data.date.toISOString(),
    ...(post.data.image ? { image: absoluteUrl(post.data.image) } : {}),
    author: authorNode(post.data.author, orgId),
    inLanguage: "en-IN",
  })),
};
---

<BaseLayout
  title="Blog"
  description="Corporate signage insights, RVI industry news, branding trends, and updates from ZN Enterprises."
  seo={{ breadcrumbs, pageType: "CollectionPage", mainEntity: blogSchema }}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Blog</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Latest <span class="gradient-text">Articles</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Corporate signage insights, RVI industry updates, branding trends, and best practices from the ZN Enterprises team.
          </p>
        </div>

        {categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-10 mb-10">
            <a href={p("/blog/")} class="px-4 py-2 rounded-full text-sm font-medium bg-accent text-accent-text">All</a>
            {categories.map((cat) => (
              <a
                href={`/blog/?category=${cat.toLowerCase()}`}
                class="px-4 py-2 rounded-full text-sm font-medium bg-muted/10 text-muted hover:bg-muted/20 transition-colors"
              >
                {cat}
              </a>
            ))}
          </div>
        )}

        {posts.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-card border border-border rounded-2xl">
            <svg class="h-16 w-16 mx-auto text-muted/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <h3 class="text-xl font-semibold mb-2">No Articles Yet</h3>
            <p class="text-muted mb-6">Check back soon for new content on corporate signage and branding.</p>
            <a
              href={p("/contact/")}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200"
            >
              Subscribe to Updates
            </a>
          </div>
        )}
      </div>
    </section>

    <CTA
      title="Want to Learn More?"
      description="Contact our team for expert advice on your corporate signage project."
      primaryLabel="Get in Touch"
      primaryHref={p("/contact/")}
    />
  </div>
</BaseLayout>
