---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BlogCard from "../components/BlogCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { getCollection } from "astro:content";
import { getSiteSettings } from "../lib/site";

const settings = await getSiteSettings();

const featuredServices = (await getCollection("services"))
  .filter((s) => s.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 4);

const featuredProducts = (await getCollection("products"))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 8);

const latestPosts = (await getCollection("blog"))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const testimonials = (await getCollection("testimonials"))
  .filter((t) => t.data.featured)
  .slice(0, 3);

const whyChooseUs = [
  {
    title: "8+ Years Experience",
    description: "Proven track record in delivering premium corporate signage solutions across India.",
    icon: "M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z",
  },
  {
    title: "Quality Manufacturing",
    description: "State-of-the-art fabrication facility producing signage with precision and durability.",
    icon: "M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z",
  },
  {
    title: "Nationwide Service",
    description: "Pan-India installation and maintenance network serving corporate clients everywhere.",
    icon: "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Timely Delivery",
    description: "Commitment to project schedules with efficient project management and execution.",
    icon: "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z",
  },
];

const stats = [
  { label: "Years Experience", value: "8+" },
  { label: "Annual Project Execution", value: "₹11 Cr" },
  { label: "Annual Business Opportunity", value: "₹10 Cr" },
  { label: "Corporate Clients", value: "Pan-India" },
];

const clients = [
  { name: "HPCL" },
  { name: "BPCL" },
  { name: "IOCL" },
  { name: "Diamond Display Pvt Ltd" },
  { name: "Sinex Systems Pvt Ltd" },
  { name: "Intersil Metallic Products" },
];
---

<BaseLayout preloadHero>
  <Hero />

  {/* Company Introduction */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Welcome to Z N ENTERPRISES</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mt-3 mb-6">
            India's Trusted<br />
            <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Corporate Signage Partner</span>
          </h2>
          <p class="text-muted leading-relaxed text-lg mb-6">
            At Z N ENTERPRISES, we specialize in designing, manufacturing, installing, repairing, and maintaining premium corporate signage across India. From petroleum stations to corporate offices, we deliver signage solutions that meet the highest standards of engineering quality and corporate branding.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            With 8+ years of experience and an annual project execution capability of ₹11 Crore, we are the preferred signage partner for major corporations across automotive, petroleum, banking, telecom, and retail sectors.
          </p>
          <a href="/about/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200">
            Learn Our Story
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-section flex items-center justify-center">
            <div class="text-center p-8">
              <svg class="h-16 w-16 mx-auto text-accent/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" /></svg>
              <p class="text-muted text-sm">Corporate Signage</p>
            </div>
          </div>
          <div class="aspect-[3/4] rounded-2xl overflow-hidden mt-8 bg-section flex items-center justify-center">
            <div class="text-center p-8">
              <svg class="h-16 w-16 mx-auto text-accent/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
              <p class="text-muted text-sm">LED Sign Boards</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="bg-section py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl sm:text-5xl font-black text-accent mb-2">{stat.value}</div>
            <div class="text-sm uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Services Overview */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          Our <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Services</span>
        </h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">Comprehensive corporate signage solutions under one roof.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredServices.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            features={service.data.features}
            icon={service.data.icon}
            href={`/services/${service.id}/`}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
          View All Services
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  {/* Why Choose Us */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          Why Choose <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Z N ENTERPRISES</span>
        </h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">What sets us apart from the competition.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {whyChooseUs.map((item) => (
          <div class="text-center group">
            <div class="mx-auto mb-5 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-soft text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-accent-text">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <h3 class="text-lg font-semibold mb-3">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Products */}
  {featuredProducts.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            Our <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Products</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">Premium signage solutions engineered for corporate excellence.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product) => (
            <article class="rounded-2xl bg-card border-border shadow-sm hover:shadow-lg hover:border-accent-border hover:-translate-y-1 transition-all duration-300 p-6 sm:p-8 group">
              <h3 class="text-lg font-semibold mb-3">{product.data.title}</h3>
              <p class="text-muted text-sm leading-relaxed mb-4">{product.data.excerpt || product.data.description}</p>
              {product.data.features && product.data.features.length > 0 && (
                <ul class="space-y-2 mb-5">
                  {product.data.features.slice(0, 3).map((feature) => (
                    <li class="flex items-center gap-2 text-sm text-body/70">
                      <svg class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              )}
              <a href={`/products/${product.id}/`} class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-hover transition-colors">
                Learn More
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/products/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
            View All Products
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Major Clients */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          Our <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Clients</span>
        </h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">Trusted by leading corporations across India.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6">
        {clients.map((client) => (
          <div class="card p-6 text-center flex items-center justify-center">
            <span class="font-semibold text-lg text-muted">{client.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Testimonials */}
  {testimonials.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            What Our <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Clients Say</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">Trusted by leading corporations across India.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {testimonials.map((t) => (
            <TestimonialCard
              name={t.data.name}
              content={t.data.content}
              role={t.data.role}
              company={t.data.company}
              avatar={t.data.avatar}
              rating={t.data.rating}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Recent Blog Posts */}
  {latestPosts.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            Latest <span class="bg-linear-to-r from-accent to-accent-hover bg-clip-text text-transparent">Articles</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">Insights on corporate signage, branding, and industry trends.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/blog/" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-btn-secondary-border text-body px-6 py-3 font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200">
            View All Articles
          </a>
        </div>
      </div>
    </section>
  )}

  {/* CTA Section */}
  <section class="py-16 sm:py-20 lg:py-24 relative overflow-hidden bg-inverse">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(220,38,38,0.1),transparent_60%)]" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-inverted mb-4">
        Ready to Elevate Your Brand?
      </h2>
      <p class="text-inverted/60 text-lg max-w-2xl mx-auto mb-8">
        Contact us today to discuss your corporate signage requirements. From design to installation, we deliver excellence.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
          Request a Quote
        </a>
        <a href={`tel:${settings.phone[0].replace(/[^0-9]/g, "")}`} class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-inverted/30 text-inverted px-8 py-4 text-lg font-medium hover:bg-inverted hover:text-inverse transition-all duration-200">
          Call {settings.phone[0].replace(/[^0-9]/g, "").replace(/(\d{5})(\d{5})/, "$1 $2")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
