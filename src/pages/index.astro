---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StatsBar from "../components/StatsBar.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import CTA from "../components/CTA.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BlogCard from "../components/BlogCard.astro";
import ClientCard from "../components/ClientCard.astro";
import { getCollection } from "astro:content";
import { p, getSiteSettings } from "../lib/site";


const settings = await getSiteSettings();

const featuredServices = (await getCollection("services"))
  .filter((s) => s.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 4);

const featuredProducts = (await getCollection("products"))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 4);

const latestPosts = (await getCollection("blog"))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const clients = (await getCollection("clients"))
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const [aboutEntry] = await getCollection("about");
const a = aboutEntry?.data;
const homeLabel = a?.homeLabel ?? "/// About";
const homeHeading = a?.homeHeading ?? "About ZN Enterprises";
const homeHighlight = a?.homeHighlight ?? "ZN Enterprises";
const homeSubHead = a?.homeSubHead ?? "We Engineer Your Brand's Visual Identity.";
const homeProblem = a?.homeProblem ?? "";
const homeSolution = a?.homeSolution ?? "";
const homePhilosophy = a?.homePhilosophy ?? "";
const homeMissionTitle = a?.missionTitle ?? "Our Mission";
const homeMissionText = a?.missionText ?? "";
const homeVisionTitle = a?.visionTitle ?? "Our Vision";
const homeVisionText = a?.visionText ?? "";
const homeValues = a?.values ?? [];
const homeHeadingParts = homeHeading.split(homeHighlight);
const showHomeHighlight = homeHeadingParts.length > 1 && homeHighlight;

const homeStats = a?.stats?.length ? a.stats.map((s) => ({ label: s.label, value: s.number })) : undefined;

const ctaTitle = a?.ctaTitle ?? "Ready to Transform Your Brand's Visibility?";
const ctaDescription = a?.ctaDescription ?? "From brief to installation. No delays. No compromises. India's top petroleum chains trust us — you can too.";
const ctaPrimaryLabel = a?.ctaPrimaryLabel ?? "Request a Free Quote";
const ctaPrimaryHref = a?.ctaPrimaryLink ? p(a.ctaPrimaryLink) : p("/contact/");

const whatsappHref = `https://wa.me/${(settings.social?.whatsapp ?? settings.phone[0]).replace(/[^0-9]/g, "")}`;

const defaultWhyChooseUs = [
  {
    title: "100% In-House Control",
    description: "No outsourcing. No middlemen. We control the quality from fabrication to installation. When something breaks, we fix it instantly.",
    icon: "M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21",
  },
  {
    title: "Across India Installation Network",
    description: "We have the capability to install. Coordinated teams. Synchronized rollouts. No delays.",
    icon: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
  },
  {
    title: "Petroleum Grade Specialists",
    description: "We thrive in highly regulated, high-traffic environments. With 350+ annual petroleum installations, we know compliance inside and out.",
    icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12",
  },
  {
    title: "Speed Without Compromise",
    description: "2 weeks from fabrication to installation (for one petroleum project). We deliver fast and maintain quality.",
    icon: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
  },
  {
    title: "Lifetime Support",
    description: "Our job doesn't end at handover. Broken LED? We replace it. You focus on running your business; we handle your visibility.",
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  },
];
const whyChooseUs = a?.whyChooseUs?.length ? a.whyChooseUs : defaultWhyChooseUs;

---


<BaseLayout
  title="Elevate Your Brand Visibility"
  description="Premium signage solution across India. End-to-end signage for petroleum and retail brands — manufactured, installed, and maintained 100% in-house by ZN Enterprises."
  preloadHero
  seo={{
    pageType: "HomePage",
  }}
>
  <Hero />

  <StatsBar stats={homeStats} />

  {/* About */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">{homeLabel}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3">
            {showHomeHighlight ? homeHeadingParts[0] : homeHeading}
            {showHomeHighlight && <span class="gradient-text">{homeHighlight}</span>}
            {showHomeHighlight && homeHeadingParts.slice(1).join("")}
          </h2>
          <p class="text-lg sm:text-xl font-medium text-body mb-8">{homeSubHead}</p>

          {homeProblem && (
            <div class="mb-6">
              <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-accent-strong mb-2">The Problem We Solve</h3>
              <p class="text-muted leading-relaxed">{homeProblem}</p>
            </div>
          )}
          {homeSolution && (
            <div class="mb-6">
              <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-accent-strong mb-2">Our Solution</h3>
              <p class="text-muted leading-relaxed">{homeSolution}</p>
            </div>
          )}
          {homePhilosophy && (
            <div class="mb-6">
              <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-accent-strong mb-2">Our Philosophy</h3>
              <p class="text-muted leading-relaxed">{homePhilosophy}</p>
            </div>
          )}
        </div>

        <div>
          <div class="grid sm:grid-cols-2 gap-4 mb-6">
            <div class="bg-card border border-border rounded-2xl p-6 hover:border-accent-border transition-colors">
              <h3 class="font-semibold mb-2">{homeMissionTitle}</h3>
              <p class="text-sm text-muted leading-relaxed">{homeMissionText}</p>
            </div>
            <div class="bg-card border border-border rounded-2xl p-6 hover:border-accent-border transition-colors">
              <h3 class="font-semibold mb-2">{homeVisionTitle}</h3>
              <p class="text-sm text-muted leading-relaxed">{homeVisionText}</p>
            </div>
          </div>

          {homeValues.length > 0 && (
            <div class="space-y-3 mb-8">
              {homeValues.map((v) => (
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 h-5 w-5 shrink-0 rounded-full bg-accent-soft text-accent-strong flex items-center justify-center">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  </span>
                  <div>
                    <span class="font-medium text-sm">{v.title}:</span>{" "}
                    <span class="text-sm text-muted">{v.description}</span>
                  </div>
                </div>
              ))}
            </div>
          )}

          <a
            href={p("/projects/")}
            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-6 py-3 font-medium hover:bg-body hover:text-page transition-all duration-200"
          >
            See What We've Built
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Services */}
  {featuredServices.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// What We Do</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            What We <span class="gradient-text">Deliver</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">End-to-end signage solutions for petroleum and retail brands — manufactured, installed, and maintained 100% in-house.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredServices.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              icon={service.data.icon}
              href={`/services/${service.id}/`}
              features={service.data.features?.slice(0, 3)}
              image={service.data.image}
            />
          ))}
        </div>
        <div class="text-center mt-10">
          <a
            href={p("/services/")}
            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-6 py-3 font-medium hover:bg-body hover:text-page transition-all duration-200"
          >
            Get Your Signage Project Started
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Why Choose Us */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Why Us</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          Why India's Top Brands <span class="gradient-text">Trust ZN Enterprises</span>?
        </h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">What sets us apart as India's trusted petroleum &amp; retail signage partner.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {whyChooseUs.map((item) => (
          <div class="text-center group">
            <div class="mx-auto mb-5 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-soft text-accent-strong transition-all duration-300 group-hover:bg-accent group-hover:text-accent-text shadow-sm group-hover:shadow-lg group-hover:shadow-accent/25">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <h3 class="text-lg font-semibold mb-3">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Products */}
  {featuredProducts.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Products</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            Engineered for <span class="gradient-text">Maximum Impact</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">Premium signage solutions engineered for petroleum, corporate, and retail brands — built to last.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product) => (
            <article class="rounded-2xl bg-card border border-border hover:shadow-lg hover:border-accent-border hover:-translate-y-1 transition-all duration-300 overflow-hidden group">
              {product.data.image && (
                <a href={p(`/products/${product.id}/`)} class="block" tabindex="-1" aria-hidden="true">
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={p(product.data.image)}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                </a>
              )}
              <div class="p-6 sm:p-8">
                <div class="mb-4">
                  {product.data.category && (
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-accent-soft text-accent-strong">{product.data.category}</span>
                  )}
                </div>
                <h3 class="text-lg font-semibold mb-3">{product.data.title}</h3>
                <p class="text-muted text-sm leading-relaxed mb-4">{product.data.excerpt || product.data.description}</p>
                {product.data.features && product.data.features.length > 0 && (
                  <ul class="space-y-2 mb-5">
                    {product.data.features.slice(0, 3).map((feature: string) => (
                      <li class="flex items-center gap-2 text-sm text-body/70">
                        <svg class="h-4 w-4 text-accent-strong shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {feature}
                      </li>
                    ))}
                  </ul>
                )}
                <a href={p(`/products/${product.id}/`)} class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-hover transition-colors">
                  Learn More
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="text-center mt-10">
          <a
            href={p("/products/")}
            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-6 py-3 font-medium hover:bg-body hover:text-page transition-all duration-200"
          >
            View Completed Projects
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Process */}
  <ProcessTimeline />

  {/* Clients */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Clients</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            Trusted by India's <span class="gradient-text">Leading Petroleum Giants</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">The proof is in the numbers — 350+ petroleum outlets handled annually. ₹11 Crore+ operational capacity. 8+ years of relentless delivery.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {clients.map((client) => (
          <ClientCard
            name={client.data.name}
            fullName={client.data.fullName}
            logo={client.data.logo}
            description={client.data.description}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={p("/projects/")}
          class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-6 py-3 font-medium hover:bg-body hover:text-page transition-all duration-200"
        >
          See What We've Built for Them
        </a>
      </div>
    </div>
  </section>

  {/* Blog */}
  {latestPosts.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 sm:mb-16">
          <span class="inline-block text-accent-strong font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// Insights</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
            Latest <span class="gradient-text">Articles</span>
          </h2>
          <p class="text-muted text-lg max-w-2xl mx-auto">Insights on corporate signage, RVI, branding trends, and industry best practices.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
        <div class="text-center mt-10">
          <a
            href={p("/blog/")}
            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-6 py-3 font-medium hover:bg-body hover:text-page transition-all duration-200"
          >
            View All Articles
          </a>
        </div>
      </div>
    </section>
  )}

  <CTA
    title={ctaTitle}
    description={ctaDescription}
    primaryLabel={ctaPrimaryLabel}
    primaryHref={ctaPrimaryHref}
    secondaryLabel="Chat With Us on WhatsApp"
    secondaryHref={whatsappHref}
  />
</BaseLayout>
