---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { p } from "../lib/site";


const faqs = [
  { q: "What types of signage does ZN Enterprises manufacture?", a: "We manufacture a comprehensive range of signage including LED sign boards, illuminated signage, non-illuminated signage, ACP signage, acrylic signage, channel letters, monoliths, totems, pylons, wayfinding systems, directional signage, architectural signage, and complete petroleum station branding solutions." },
  { q: "Which industries do you serve?", a: "We primarily serve petroleum companies (IOCL, HPCL, BPCL, CPCL, MRPL, Shell, Reliance, Aegis), automotive dealerships (Honda, TVS, Suzuki, Yamaha), banks (SBI, Bank of India, ICICI, HDFC), telecommunications providers (Airtel, Vodafone Idea, Jio), and industrial/manufacturing clients across India." },
  { q: "Do you provide installation services across India?", a: "Yes, we have a pan-India installation network. Our trained technicians can deploy signage solutions at any location across the country, ensuring consistent quality and timely completion." },
  { q: "What materials do you use for signage fabrication?", a: "We work with premium materials including ACP (Aluminium Composite Panels), MS (Mild Steel), GI (Galvanized Iron), Aluminium, Polycarbonate, Acrylic, PET-G, Cast Vinyl, Calendared Vinyl, architectural LED modules, and low-voltage lighting systems." },
  { q: "Do you offer annual maintenance contracts?", a: "Yes, we offer comprehensive Annual Maintenance Contracts (AMC) for corporate signage. Our AMC includes regular inspections, LED replacement, structural checks, cleaning, and priority breakdown support." },
  { q: "What is your project workflow?", a: "Our standard process includes: consultation, site survey, design and engineering, structural approval, precision manufacturing, quality inspection, professional installation, final handover, and ongoing maintenance support." },
  { q: "Can you handle large-scale nationwide rollouts?", a: "Absolutely. We have extensive experience executing large-scale branding projects and multi-location signage rollouts for major corporations across all states of India." },
  { q: "How do I request a quote?", a: "You can request a quote by filling out our contact form, emailing imran@znenterprises.in, or calling +91 9902595400. Our team will schedule a site survey and provide a detailed quotation." },
  { q: "What is the typical timeline for a signage project?", a: "Timelines vary based on the scope and complexity of the project. We provide detailed project schedules during the quotation phase and are committed to on-time delivery." },
  { q: "Where are you located?", a: "Our office is at K.G Halli, Bengaluru, with our manufacturing facility in Kengeri, Bengaluru. We provide services across India." },
];
---

<BaseLayout
  title="FAQ"
  description="Frequently asked questions about ZN Enterprises corporate signage services, manufacturing, installation, and maintenance."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// FAQ</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
            Frequently Asked <span class="gradient-text">Questions</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Find answers to common questions about our corporate signage services, manufacturing capabilities, and project execution.
          </p>
        </div>

        <div class="max-w-3xl space-y-3 mt-12">
          {faqs.map((faq) => (
            <details class="bg-card border border-border rounded-xl transition-all duration-200 open:border-accent-border open:shadow-sm group">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-medium text-body group-open:text-accent">
                <span>{faq.q}</span>
                <svg class="h-5 w-5 text-muted shrink-0 transition-transform duration-200 group-open:rotate-180 group-open:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-muted leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA
      title="Still Have Questions?"
      description="Contact our team directly. We're happy to discuss your specific signage requirements."
      primaryLabel="Contact Us"
      primaryHref={p("/contact/")}
    />
  </div>
</BaseLayout>
