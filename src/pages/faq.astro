---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const faqs = [
  { q: "What types of signage does Z N ENTERPRISES manufacture?", a: "We manufacture a comprehensive range of signage including LED sign boards, illuminated signage, non-illuminated signage, ACP signage, acrylic signage, totem signage, monolith signage, pylon signage, wayfinding systems, and complete petroleum station branding solutions." },
  { q: "Which industries do you serve?", a: "We serve petroleum companies (IOCL, HPCL, BPCL, MRPL, Shell, Reliance), automobile dealerships, banks (SBI, Bank of India, ICICI, HDFC), telecommunication providers (Airtel, Vodafone, Jio), retail businesses, and commercial infrastructure sectors across India." },
  { q: "Do you provide installation services across India?", a: "Yes, we have a pan-India installation network. Our trained technicians can deploy signage solutions at any location across the country, ensuring consistent quality and timely completion." },
  { q: "What materials do you use for signage fabrication?", a: "We work with a wide range of premium materials including ACP (Aluminium Composite Panels), LED modules, MS (Mild Steel), GI (Galvanized Iron), Aluminium, PCU (Polycarbonate), PET-G, Vinyl, Graphics, and Acrylic." },
  { q: "Do you offer annual maintenance contracts?", a: "Yes, we offer comprehensive Annual Maintenance Contracts (AMC) for corporate signage. Our AMC includes regular inspections, cleaning, LED replacement, structural checks, and priority repair service." },
  { q: "How do I request a quote?", a: "You can request a quote by contacting us through our website form, emailing us at info@znenterprises.in, or calling us directly. Our team will schedule a site survey and provide a detailed quotation." },
  { q: "What are your operating hours?", a: "We are open Monday through Saturday, from 9:00 AM to 6:00 PM." },
  { q: "Where are you located?", a: "We are based in Bangalore, Karnataka, India, with service capabilities across the country." },
  { q: "Can you handle large-scale nationwide rollouts?", a: "Absolutely. We have extensive experience executing large-scale branding projects and multi-location signage rollouts for major corporations across India." },
  { q: "What is the typical timeline for a signage project?", a: "Timelines vary based on the scope of work. We provide detailed project schedules during the quotation phase and are committed to timely delivery." },
];
---

<BaseLayout
  title="FAQ"
  description="Frequently asked questions about Z N ENTERPRISES corporate signage services."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/faq/" class="mb-8" />
        <div class="section-title text-left max-w-2xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">FAQ</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Frequently Asked <span class="gradient-text">Questions</span>
          </h1>
          <p class="text-muted text-lg">
            Find answers to common questions about our services.
          </p>
        </div>
        <div class="max-w-3xl space-y-3 mt-12">
          {faqs.map((faq, i) => (
            <details class="card group open:border-accent-border transition-all duration-200">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-medium">
                <span>{faq.q}</span>
                <svg class="h-5 w-5 text-muted shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-muted leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
