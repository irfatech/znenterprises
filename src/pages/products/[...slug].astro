---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// {data.category || "Product"}</span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">{data.title}</h1>
            <p class="text-muted text-lg leading-relaxed mb-8">{data.description}</p>

            {data.features && data.features.length > 0 && (
              <div class="mb-8">
                <h2 class="text-lg font-semibold mb-4">Key Features</h2>
                <ul class="space-y-3">
                  {data.features.map((f) => (
                    <li class="flex items-center gap-3">
                      <svg class="h-5 w-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <a
              href="/contact/"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 font-medium hover:bg-accent-hover transition-all duration-200 shadow-sm hover:shadow-md active:scale-[0.98]"
            >
              Enquire About This Product
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>

          <div class="aspect-[4/3] rounded-2xl overflow-hidden">
            <img
              src={data.image || "https://images.unsplash.com/photo-1565479786208-530fb8a4fc0e?w=800&q=80"}
              alt={data.title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <div class="mt-16 max-w-3xl">
          <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-body prose-a:text-accent">
            <Content />
          </div>
        </div>
      </div>
    </section>

    <CTA
      title="Interested in This Product?"
      description="Contact us for pricing, specifications, and customization options."
      primaryLabel="Request a Quote"
      primaryHref="/contact/"
    />
  </div>
</BaseLayout>
