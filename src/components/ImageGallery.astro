---
interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
---

{images.length > 0 && (
  <div class="product-gallery" data-gallery={galleryId}>
    <button
      type="button"
      class="group relative block w-full aspect-[4/3] rounded-2xl overflow-hidden bg-card border border-border cursor-zoom-in"
      data-gallery-open
      data-index="0"
      aria-label={`Open image gallery — photo 1 of ${images.length}`}
    >
      <img
        src={images[0]}
        alt={alt}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 inline-flex items-center gap-2 rounded-full bg-white/95 text-body px-4 py-2 text-sm font-medium shadow-lg">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
          </svg>
          View gallery
        </span>
      </div>
      {images.length > 1 && (
        <span class="absolute bottom-3 right-3 rounded-full bg-black/60 text-white text-xs font-medium px-3 py-1.5 backdrop-blur-sm">
          1 / {images.length}
        </span>
      )}
    </button>

    {images.length > 1 && (
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-3 mt-3">
        {images.slice(1).map((img, i) => (
          <button
            type="button"
            class="group relative aspect-square rounded-xl overflow-hidden bg-card border border-border cursor-pointer"
            data-gallery-open
            data-index={i + 1}
            aria-label={`Open image gallery — photo ${i + 2} of ${images.length}`}
          >
            <img src={img} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-200" />
          </button>
        ))}
      </div>
    )}

    <div class="fixed inset-0 z-100 hidden" data-gallery-lightbox role="dialog" aria-modal="true" aria-label={`${alt} — image gallery`}>
      <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" data-gallery-backdrop></div>

      <button
        type="button"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
        data-gallery-close
        aria-label="Close gallery"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <span class="absolute top-5 left-4 sm:top-7 sm:left-6 z-10 text-white/70 text-sm font-medium" data-gallery-counter></span>

      {images.length > 1 && (
        <>
          <button
            type="button"
            class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
            data-gallery-prev
            aria-label="Previous image"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
            data-gallery-next
            aria-label="Next image"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </>
      )}

      <div class="relative z-5 h-full w-full overflow-hidden" data-gallery-track>
        {images.map((img, i) => (
          <div class="absolute inset-0 flex items-center justify-center px-4 sm:px-16 py-16 transition-transform duration-300 ease-out" data-gallery-slide data-index={i}>
            <img
              src={img}
              alt={`${alt} — photo ${i + 1} of ${images.length}`}
              class="max-h-full max-w-full object-contain rounded-lg select-none"
              loading="lazy"
              draggable="false"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
      if (root.dataset.galleryInit) return;
      root.dataset.galleryInit = "true";

      const lightbox = root.querySelector<HTMLElement>("[data-gallery-lightbox]");
      const track = root.querySelector<HTMLElement>("[data-gallery-track]");
      const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const counter = root.querySelector<HTMLElement>("[data-gallery-counter]");
      const openTriggers = Array.from(root.querySelectorAll<HTMLElement>("[data-gallery-open]"));
      const closeBtn = root.querySelector<HTMLElement>("[data-gallery-close]");
      const backdrop = root.querySelector<HTMLElement>("[data-gallery-backdrop]");
      const prevBtn = root.querySelector<HTMLElement>("[data-gallery-prev]");
      const nextBtn = root.querySelector<HTMLElement>("[data-gallery-next]");
      if (!lightbox || !track || slides.length === 0) return;

      const total = slides.length;
      let current = 0;
      let lastFocused: HTMLElement | null = null;

      function render() {
        slides.forEach((slide, i) => {
          slide.style.transform = `translateX(${(i - current) * 100}%)`;
        });
        if (counter) counter.textContent = `${current + 1} / ${total}`;
      }

      function onKeydown(e: KeyboardEvent) {
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") go(-1);
        else if (e.key === "ArrowRight") go(1);
      }

      function open(index: number) {
        current = index;
        render();
        lastFocused = document.activeElement as HTMLElement;
        lightbox!.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
        document.addEventListener("keydown", onKeydown);
      }

      function close() {
        lightbox!.classList.add("hidden");
        document.body.style.overflow = "";
        document.removeEventListener("keydown", onKeydown);
        lastFocused?.focus();
      }

      function go(delta: number) {
        current = (current + delta + total) % total;
        render();
      }

      openTriggers.forEach((btn) => {
        btn.addEventListener("click", () => open(parseInt(btn.dataset.index || "0", 10)));
      });
      closeBtn?.addEventListener("click", close);
      backdrop?.addEventListener("click", close);
      prevBtn?.addEventListener("click", () => go(-1));
      nextBtn?.addEventListener("click", () => go(1));

      let touchStartX = 0;
      let touchDeltaX = 0;
      track.addEventListener("touchstart", (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
        touchDeltaX = 0;
      }, { passive: true });
      track.addEventListener("touchmove", (e: TouchEvent) => {
        touchDeltaX = e.touches[0].clientX - touchStartX;
      }, { passive: true });
      track.addEventListener("touchend", () => {
        if (Math.abs(touchDeltaX) > 50) go(touchDeltaX < 0 ? 1 : -1);
        touchDeltaX = 0;
      });

      render();
    });
  }

  initGalleries();
  document.addEventListener("astro:page-load", initGalleries);
</script>
