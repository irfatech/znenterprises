---
import { getCollection } from "astro:content";

const [processEntry] = await getCollection("process");
const p = processEntry?.data;

const sectionLabel = p?.sectionLabel ?? "/// Our Process";
const heading = p?.heading ?? "How We Deliver";
const highlightWord = p?.highlightWord ?? "Deliver";
const subtitle = p?.subtitle ?? "";
const steps = p?.steps ?? [];

const headingParts = heading.split(highlightWord);
const showHighlight = headingParts.length > 1 && highlightWord;
---

<section class="py-16 sm:py-20 lg:py-24 bg-section overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">{sectionLabel}</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        {showHighlight ? headingParts[0] : heading}
        {showHighlight && <span class="gradient-text">{highlightWord}</span>}
        {showHighlight && headingParts.slice(1).join("")}
      </h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div class="relative group animate-fade-in" style={`animation-delay: ${i * 0.1}s`}>
          <div class="relative bg-card border border-border rounded-xl p-6 pt-12 h-full hover:border-accent-border hover:shadow-lg transition-all duration-300">
            <div class="absolute -top-4 left-6 h-8 w-8 rounded-full bg-inverse border-2 border-accent text-inverted flex items-center justify-center text-xs font-bold shadow-lg">
              {step.number}
            </div>
            <div class="absolute top-0 right-4 text-6xl font-black text-accent/[0.04] leading-none select-none pointer-events-none">
              {step.number}
            </div>
            <h3 class="text-lg font-semibold mb-2">{step.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href="/contact/"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200 shadow-lg shadow-accent/25"
      >
        Start Your Project Today
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </div>
</section>
