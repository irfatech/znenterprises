---
import { buildSEO } from "../lib/seo";
import { getSiteSettings, p, absoluteUrl, normalizeTelephone } from "../lib/site";
import { getImageMeta } from "../lib/imageMeta";
import type { SEOProps } from "../lib/seo";
import { getCollection } from "astro:content";

const settings = await getSiteSettings();
const services = await getCollection("services");
const products = await getCollection("products");
const isHome = Astro.url.pathname === "/";

const {
  title,
  description,
  image,
  imageAlt,
  canonical,
  noIndex,
  type,
  publishedTime,
  modifiedTime,
  author,
  articleSection,
  articleTags,
  breadcrumbs,
  pageType,
  mainEntity,
  hideBusinessSchema,
} = buildSEO(Astro.props as SEOProps);

const baseUrl = Astro.site;
const ogImage = new URL(p(image), baseUrl).href;
const ogImageMeta = getImageMeta(image);
const ogImageAlt = imageAlt || title;

const pageUrl = canonical || Astro.url.href;
const siteUrl = settings.url;
const orgId = `${siteUrl}/#organization`;
const siteId = `${siteUrl}/#website`;
const webPageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;

function parseAddress(raw?: string) {
  if (!raw) return undefined;
  const parts = raw.split(",").map((s) => s.trim()).filter(Boolean);
  const last = parts[parts.length - 1] ?? "";
  const match = last.match(/^(.*?)\s*[-–]?\s*(\d{6})$/);
  let locality = last;
  let postalCode: string | undefined;
  if (match) {
    locality = (match[1] || "Bengaluru").trim();
    postalCode = match[2];
  }
  return {
    "@type": "PostalAddress",
    streetAddress: parts.slice(0, -1).join(", "),
    addressLocality: locality || "Bengaluru",
    addressRegion: "Karnataka",
    postalCode,
    addressCountry: "IN",
  };
}

const hasBusinessSchema = !hideBusinessSchema;

const knowsAbout = Array.from(
  new Set([
    "Retail Visual Identity (RVI)",
    "Petroleum Signage",
    "Corporate Signage",
    "LED Signage",
    "Industrial Fabrication",
    "Nationwide Signage Installation",
    ...services.map((s) => s.data.title),
    ...products.map((pr) => pr.data.title),
  ]),
).filter(Boolean);

const offerCatalog = isHome
  ? {
      "@type": "OfferCatalog",
      name: "Signage Services and Products",
      itemListElement: [
        ...services.map((s) => ({
          "@type": "Offer",
          "@id": `${absoluteUrl(`/services/${s.id}/`)}#offer`,
          itemOffered: { "@id": absoluteUrl(`/services/${s.id}/`) },
        })),
        ...products.map((pr) => ({
          "@type": "Offer",
          "@id": `${absoluteUrl(`/products/${pr.id}/`)}#offer`,
          itemOffered: { "@id": absoluteUrl(`/products/${pr.id}/`) },
        })),
      ],
    }
  : undefined;

const organizationNode = hasBusinessSchema
  ? {
      "@type": ["Organization", "LocalBusiness"],
      "@id": orgId,
      name: settings.siteName,
      url: siteUrl,
      logo: settings.logo ? absoluteUrl(settings.logo) : undefined,
      image: absoluteUrl("/images/og-default.jpg"),
      slogan: settings.tagline,
      description: settings.description,
      telephone: settings.phone[0] ? normalizeTelephone(settings.phone[0]) : undefined,
      email: settings.email,
      address: parseAddress(settings.address),
      ...(settings.foundingDate ? { foundingDate: settings.foundingDate } : {}),
      ...(settings.taxID ? { taxID: settings.taxID } : {}),
      ...(settings.founder ? { founder: { "@type": "Person", name: settings.founder } } : {}),
      ...(settings.numberOfEmployees && settings.numberOfEmployees > 0
        ? { numberOfEmployees: { "@type": "QuantitativeValue", value: settings.numberOfEmployees } }
        : {}),
      ...(settings.geo
        ? {
            geo: {
              "@type": "GeoCoordinates",
              latitude: settings.geo.latitude,
              longitude: settings.geo.longitude,
            },
          }
        : {}),
      ...(settings.address
        ? {
            hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(settings.address)}`,
            map: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(settings.address)}`,
          }
        : {}),
      areaServed: { "@type": "Country", name: "IN" },
      currenciesAccepted: settings.currency || "INR",
      knowsAbout,
      contactPoint: settings.phone.map((tel, i) => ({
        "@type": "ContactPoint",
        telephone: normalizeTelephone(tel),
        contactType: i === 0 ? "sales" : "customer service",
        areaServed: { "@type": "Country", name: "IN" },
        availableLanguage: "en",
        ...(settings.email ? { email: settings.email } : {}),
      })),
      openingHoursSpecification: settings.workingHours
        ? [
            {
              "@type": "OpeningHoursSpecification",
              dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              opens: "09:00",
              closes: "18:00",
            },
          ]
        : undefined,
      sameAs: [
        settings.social?.facebook,
        settings.social?.instagram,
        settings.social?.youtube,
        settings.social?.tiktok,
      ].filter((l): l is string => Boolean(l && l.trim())),
      ...(offerCatalog ? { hasOfferCatalog: offerCatalog } : {}),
    }
  : null;

const websiteNode = hasBusinessSchema
  ? {
      "@type": "WebSite",
      "@id": siteId,
      url: siteUrl,
      name: settings.siteName,
      description: settings.description,
      inLanguage: "en-IN",
      publisher: { "@id": orgId },
    }
  : null;

const webPageNode = {
  "@type": pageType || "WebPage",
  "@id": webPageId,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en-IN",
  ...(hasBusinessSchema ? { isPartOf: { "@id": siteId } } : {}),
  ...(breadcrumbs ? { breadcrumb: { "@id": breadcrumbId } } : {}),
  mainEntity: mainEntity ?? (hasBusinessSchema ? { "@id": orgId } : undefined),
};

const breadcrumbNode = breadcrumbs
  ? {
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      itemListElement: breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.label,
        item: `${siteUrl}${crumb.href}`,
      })),
    }
  : null;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode,
    websiteNode,
    webPageNode,
    breadcrumbNode,
  ].filter(Boolean),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
<link rel="canonical" href={canonical || Astro.url.href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical || Astro.url.href} />
<meta property="og:site_name" content={settings.siteName} />
<meta property="og:locale" content="en_IN" />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:image" content={ogImage} />
{ogImageMeta && <meta property="og:image:type" content={ogImageMeta.type} />}
{ogImageMeta && <meta property="og:image:width" content={ogImageMeta.width} />}
{ogImageMeta && <meta property="og:image:height" content={ogImageMeta.height} />}
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{publishedTime && <meta name="datePublished" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{articleSection && <meta property="article:section" content={articleSection} />}
{articleTags && articleTags.length > 0 && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
{author && <meta name="author" content={author} />}

<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

{breadcrumbs && (
  <nav aria-label="Breadcrumb" class="sr-only">
    <ol>
      {breadcrumbs.map((crumb) => (
        <li><a href={crumb.href}>{crumb.label}</a></li>
      ))}
    </ol>
  </nav>
)}