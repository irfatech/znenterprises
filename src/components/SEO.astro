---
import { buildSEO } from "../lib/seo";
import { getSiteSettings } from "../lib/site";
import type { SEOProps } from "../lib/seo";

const settings = await getSiteSettings();

const {
  title,
  description,
  image,
  canonical,
  noIndex,
  type,
  publishedTime,
  author,
  breadcrumbs,
} = buildSEO(Astro.props as SEOProps);

const baseUrl = Astro.site;

const schemaOrg = breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.label,
        item: `${Astro.site}${crumb.href}`,
      })),
    }
  : null;

const businessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: settings.siteName,
      url: settings.url,
      logo: settings.logo ? `${settings.url}${settings.logo}` : undefined,
      description: settings.description,
      contactPoint: settings.phone[0] ? {
        "@type": "ContactPoint",
        telephone: settings.phone[0],
        contactType: "sales",
      } : undefined,
      sameAs: [
        settings.social?.facebook,
        settings.social?.instagram,
        settings.social?.youtube,
      ].filter(Boolean),
    },
    ...(settings.address ? [{
      "@type": "LocalBusiness",
      name: settings.siteName,
      "@id": settings.url,
      url: settings.url,
      image: settings.logo ? `${settings.url}${settings.logo}` : undefined,
      telephone: settings.phone[0],
      email: settings.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: settings.address,
        addressCountry: "IN",
      },
      openingHoursSpecification: settings.workingHours ? [{
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "09:00",
        closes: "18:00",
      }] : undefined,
      priceRange: "₹₹",
    }] : []),
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical || Astro.url.href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical || Astro.url.href} />
<meta property="og:image" content={new URL(image, baseUrl).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_IN" />
<meta property="og:site_name" content="ZN Enterprises" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, baseUrl).href} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{author && <meta name="author" content={author} />}
{noIndex && <meta name="robots" content="noindex,nofollow" />}

<script type="application/ld+json" set:html={schemaOrg && JSON.stringify(schemaOrg)} />
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

{breadcrumbs && (
  <nav aria-label="Breadcrumb" class="sr-only">
    <ol>
      {breadcrumbs.map((crumb) => (
        <li><a href={crumb.href}>{crumb.label}</a></li>
      ))}
    </ol>
  </nav>
)}
