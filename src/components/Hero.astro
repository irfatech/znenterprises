---
import { getSiteSettings } from "../lib/site";

const settings = await getSiteSettings();
const phoneClean = (p: string) => p.replace(/[^0-9]/g, "");
---

<section class="relative min-h-[90vh] flex items-center bg-hero overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-900/90 via-brand-800/80 to-brand-950/90 z-10" />
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(255,94,0,0.12),transparent_50%)] z-10" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-20 py-32 lg:py-40">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-8 animate-fade-in backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse" />
        Fueling Your Visibility Across Pan-India
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold text-white leading-[0.95] tracking-tight mb-6">
        Corporate
        <br />
        <span class="gradient-text">Signage</span>
        <br />
        <span class="text-white/80">Manufacturing</span>
      </h1>

      <p class="text-lg sm:text-xl text-white/60 max-w-2xl mb-10 leading-relaxed">
        End-to-end Retail Visual Identity (RVI), corporate branding, petroleum station signage, and industrial fabrication — designed, manufactured, installed, and maintained across India.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200 shadow-lg shadow-accent/25 active:scale-[0.98]"
        >
          Request a Quote
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="/projects/"
          class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/20 text-white px-8 py-4 text-lg font-medium hover:bg-white hover:text-brand-900 transition-all duration-200"
        >
          View Our Projects
        </a>
      </div>

      <div class="mt-12 flex items-center gap-6 text-sm text-white/40">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
          ISO-Quality Fabrication
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          Pan-India Service
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          8+ Years Experience
        </span>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-page to-transparent z-10" />

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 animate-bounce">
    <svg class="h-8 w-8 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>
