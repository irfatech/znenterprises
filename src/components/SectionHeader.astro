---
interface Props {
  title: string;
  subtitle?: string;
  highlight?: string;
  align?: "center" | "left";
}

const { title, subtitle, highlight, align = "center" } = Astro.props;
---

<div class="mb-12 sm:mb-16 {align === 'left' ? 'text-left' : 'text-center'}">
  <span class="inline-block text-accent font-semibold text-xs uppercase tracking-[0.15em] mb-4">/// {title}</span>
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-body">
    {highlight ? (
      <>{subtitle} <span class="gradient-text">{highlight}</span></>
    ) : (
      subtitle
    )}
  </h2>
  {subtitle && !highlight && (
    <p class="text-muted text-lg max-w-2xl {align === 'center' ? 'mx-auto' : ''} mt-4">{subtitle}</p>
  )}
</div>
