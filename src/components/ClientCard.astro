---
import { p } from "../lib/site";

interface Props {
  name: string;
  fullName?: string;
  logo: string;
  description: string;
}

const { name, fullName, logo, description } = Astro.props;
const logoSVG = logo.replace(/\.\w+$/, ".svg");
---

<article class="group relative rounded-2xl bg-card border border-border overflow-hidden hover:border-accent-border hover:shadow-xl hover:shadow-accent/10 hover:-translate-y-1 transition-all duration-300">
  <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-transparent via-accent/0 to-transparent transition-all duration-500 group-hover:via-accent group-hover:from-accent/50 group-hover:to-accent/50" />
  <div class="aspect-[4/3] sm:aspect-[16/10] bg-[radial-gradient(ellipse_at_center,var(--color-accent-soft),var(--color-card))] flex items-center justify-center p-8 sm:p-10">
    <picture>
      <source srcset={p(logo)} type="image/webp" />
      <source srcset={p(logoSVG)} type="image/svg+xml" />
      <img
        src={p(logo)}
        alt={`${fullName || name} logo`}
        class="max-h-28 sm:max-h-32 w-auto object-contain transition-all duration-500 group-hover:scale-110 drop-shadow-sm"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <div class="p-5 sm:p-6 border-t border-border">
    <h3 class="text-lg font-bold tracking-tight mb-0.5">{name}</h3>
    {fullName && <p class="text-xs text-muted mb-2">{fullName}</p>}
    <p class="text-sm text-body/65 leading-relaxed line-clamp-2">{description}</p>
  </div>
</article>
