---
interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "md" } = Astro.props;
const sizeClasses = {
  sm: "h-10 w-10 [&>svg]:h-5 [&>svg]:w-5",
  md: "h-14 w-14 [&>svg]:h-7 [&>svg]:w-7",
  lg: "h-16 w-16 [&>svg]:h-8 [&>svg]:w-8",
};
---

<div class={`inline-flex items-center justify-center rounded-xl bg-accent-soft text-accent shrink-0 transition-all duration-300 group-hover:bg-accent group-hover:text-accent-text ${sizeClasses[size]}`}>
  <slot />
</div>
